<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#176b4d">

  <title>Sahil Makhana Store | Fresh Makhana</title>
  <meta name="description"
        content="Fresh hygienically roasted makhana delivered to your door from Sahil Makhana Store.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">

  <style>
    :root {
      --green: #176b4d;
      --green-dark: #0d5139;
      --green-light: #e8f5ef;
      --cream: #fffaf0;
      --gold: #e6a93a;
      --text: #17231e;
      --muted: #66736d;
      --white: #ffffff;
      --border: #e5ebe8;
      --shadow: 0 10px 30px rgba(23, 107, 77, .10);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      background: #f7faf8;
      color: var(--text);
      line-height: 1.5;
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* HEADER */
    header {
      background:
        radial-gradient(circle at top right, rgba(230,169,58,.18), transparent 35%),
        linear-gradient(135deg, #176b4d, #0d5139);
      color: white;
      padding: 28px 18px 34px;
      position: relative;
      overflow: hidden;
    }

    .header-inner {
      max-width: 1100px;
      margin: auto;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .logo {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      display: grid;
      place-items: center;
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.22);
      font-size: 28px;
      flex-shrink: 0;
    }

    .brand h1 {
      font-size: clamp(25px, 7vw, 40px);
      font-weight: 800;
      letter-spacing: -.8px;
      line-height: 1.1;
    }

    .brand p {
      color: rgba(255,255,255,.84);
      margin-top: 5px;
      font-size: 14px;
    }

    .hero-copy {
      margin-top: 28px;
      max-width: 680px;
    }

    .hero-copy h2 {
      font-size: clamp(28px, 8vw, 48px);
      line-height: 1.08;
      letter-spacing: -1.2px;
    }

    .hero-copy p {
      margin-top: 13px;
      color: rgba(255,255,255,.82);
      font-size: 15px;
      max-width: 550px;
    }

    .trust-row {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 20px;
    }

    .trust-pill {
      background: rgba(255,255,255,.12);
      border: 1px solid rgba(255,255,255,.16);
      border-radius: 999px;
      padding: 7px 11px;
      font-size: 12px;
      color: white;
    }

    /* MAIN */
    main {
      max-width: 1100px;
      margin: auto;
      padding: 24px 15px 100px;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 15px;
      margin-bottom: 15px;
    }

    .section-heading h2 {
      font-size: 22px;
    }

    .section-heading p {
      font-size: 13px;
      color: var(--muted);
    }

    /* CATEGORY FILTER */
    .categories {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 7px;
      margin-bottom: 22px;
      scrollbar-width: none;
    }

    .categories::-webkit-scrollbar {
      display: none;
    }

    .category-btn {
      white-space: nowrap;
      border: 1px solid var(--border);
      background: white;
      color: var(--text);
      border-radius: 999px;
      padding: 9px 15px;
      font-weight: 600;
      font-size: 13px;
      transition: .2s;
    }

    .category-btn:hover,
    .category-btn.active {
      background: var(--green);
      border-color: var(--green);
      color: white;
    }

    /* PRODUCT GRID */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 13px;
    }

    .product-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: 0 5px 18px rgba(0,0,0,.04);
      transition: transform .2s, box-shadow .2s;
    }

    .product-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
    }

    .product-image-wrap {
      position: relative;
      aspect-ratio: 1 / 1;
      background: #eef4f0;
      overflow: hidden;
    }

    .product-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .35s;
    }

    .product-card:hover .product-image {
      transform: scale(1.04);
    }

    .product-info {
      padding: 13px;
    }

    .product-category {
      font-size: 10px;
      color: var(--green);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .6px;
    }

    .product-name {
      margin-top: 4px;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
    }

    .product-description {
      margin-top: 5px;
      font-size: 11px;
      color: var(--muted);
      line-height: 1.4;
    }

    .product-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 7px;
      margin-top: 12px;
    }

    .price {
      font-size: 17px;
      font-weight: 800;
      white-space: nowrap;
    }

    .add-btn {
      border: none;
      background: var(--green);
      color: white;
      border-radius: 11px;
      padding: 9px 11px;
      font-weight: 700;
      font-size: 12px;
      transition: .2s;
    }

    .add-btn:hover {
      background: var(--green-dark);
    }

    .add-btn:active {
      transform: scale(.94);
    }

    /* ABOUT */
    .about {
      margin-top: 34px;
      background: var(--cream);
      border: 1px solid #f0e8d3;
      border-radius: 20px;
      padding: 22px;
    }

    .about h2 {
      font-size: 21px;
    }

    .about p {
      margin-top: 8px;
      color: #59625e;
      font-size: 14px;
    }

    .contact-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 17px;
    }

    .contact-card {
      background: white;
      border: 1px solid var(--border);
      padding: 13px;
      border-radius: 13px;
      font-size: 13px;
    }

    .contact-card strong {
      display: block;
      margin-bottom: 3px;
    }

    /* CART FLOAT */
    .cart-floating {
      position: fixed;
      right: 17px;
      bottom: 82px;
      z-index: 50;
      width: 58px;
      height: 58px;
      border: none;
      border-radius: 50%;
      background: var(--green);
      color: white;
      box-shadow: 0 10px 28px rgba(0,0,0,.23);
      display: grid;
      place-items: center;
      font-size: 24px;
      transition: .2s;
    }

    .cart-floating:hover {
      transform: scale(1.06);
    }

    .cart-count {
      position: absolute;
      top: -3px;
      right: -2px;
      min-width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #e54848;
      color: white;
      display: grid;
      place-items: center;
      font-size: 11px;
      font-weight: 800;
      border: 2px solid white;
    }

    /* WHATSAPP */
    .whatsapp {
      position: fixed;
      bottom: 15px;
      right: 15px;
      z-index: 49;
      background: #25D366;
      color: white;
      border-radius: 999px;
      padding: 11px 16px;
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 13px;
      font-weight: 700;
      box-shadow: 0 7px 22px rgba(0,0,0,.18);
    }

    /* MODAL */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.55);
      z-index: 100;
      display: none;
      align-items: flex-end;
      justify-content: center;
      backdrop-filter: blur(4px);
    }

    .modal-overlay.show {
      display: flex;
    }

    .modal {
      background: white;
      width: 100%;
      max-width: 650px;
      max-height: 92vh;
      overflow-y: auto;
      border-radius: 23px 23px 0 0;
      padding: 20px;
      animation: slideUp .25s ease;
    }

    @keyframes slideUp {
      from {
        transform: translateY(100%);
      }
      to {
        transform: translateY(0);
      }
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      position: sticky;
      top: -20px;
      padding: 5px 0 15px;
      background: white;
      z-index: 2;
    }

    .modal-header h2 {
      font-size: 22px;
    }

    .close-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: #f6f8f7;
      font-size: 20px;
    }

    /* CART ITEMS */
    .empty-cart {
      text-align: center;
      padding: 38px 15px;
      color: var(--muted);
    }

    .empty-cart .empty-icon {
      font-size: 45px;
      margin-bottom: 10px;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 62px 1fr;
      gap: 11px;
      padding: 13px 0;
      border-bottom: 1px solid var(--border);
    }

    .cart-thumb {
      width: 62px;
      height: 62px;
      border-radius: 11px;
      object-fit: cover;
    }

    .cart-item-name {
      font-weight: 700;
      font-size: 14px;
    }

    .cart-item-price {
      font-size: 12px;
      color: var(--muted);
      margin-top: 3px;
    }

    .cart-item-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 8px;
    }

    .quantity-control {
      display: flex;
      align-items: center;
      border: 1px solid var(--border);
      border-radius: 9px;
      overflow: hidden;
    }

    .quantity-control button {
      width: 30px;
      height: 29px;
      border: none;
      background: #f4f7f5;
      font-weight: 800;
    }

    .quantity-control span {
      width: 30px;
      text-align: center;
      font-size: 12px;
      font-weight: 700;
    }

    .remove-btn {
      border: none;
      background: transparent;
      color: #d84747;
      font-size: 12px;
      font-weight: 600;
    }

    .item-subtotal {
      font-weight: 800;
      font-size: 14px;
    }

    /* TOTAL */
    .cart-summary {
      margin-top: 18px;
      background: var(--green-light);
      padding: 16px;
      border-radius: 15px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      font-size: 14px;
    }

    .summary-row.total {
      margin-top: 8px;
      padding-top: 10px;
      border-top: 1px solid rgba(23,107,77,.16);
      font-size: 19px;
      font-weight: 800;
    }

    .checkout-btn {
      width: 100%;
      border: none;
      margin-top: 14px;
      padding: 14px;
      border-radius: 13px;
      background: var(--green);
      color: white;
      font-weight: 800;
      font-size: 15px;
    }

    .checkout-btn:disabled {
      opacity: .5;
      cursor: not-allowed;
    }

    /* CHECKOUT */
    .checkout {
      display: none;
    }

    .checkout.show {
      display: block;
    }

    .cart-view.hidden {
      display: none;
    }

    .checkout h3 {
      font-size: 19px;
      margin-bottom: 15px;
    }

    .form-group {
      margin-bottom: 13px;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      border: 1px solid #dce4df;
      border-radius: 11px;
      padding: 12px;
      outline: none;
      background: #fbfcfb;
      transition: .2s;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(23,107,77,.08);
    }

    .form-group textarea {
      min-height: 85px;
      resize: vertical;
    }

    .required {
      color: #d84747;
    }

    .submit-order {
      width: 100%;
      border: none;
      border-radius: 13px;
      padding: 14px;
      background: var(--green);
      color: white;
      font-weight: 800;
      margin-top: 5px;
    }

    .back-cart {
      border: none;
      background: transparent;
      color: var(--green);
      font-weight: 700;
      margin-bottom: 15px;
    }

    /* SUCCESS */
    .success {
      display: none;
      text-align: center;
      padding: 30px 10px 15px;
    }

    .success.show {
      display: block;
    }

    .success-icon {
      width: 65px;
      height: 65px;
      margin: auto;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--green-light);
      color: var(--green);
      font-size: 31px;
    }

    .success h2 {
      margin-top: 15px;
      font-size: 23px;
    }

    .success p {
      margin-top: 8px;
      color: var(--muted);
      font-size: 14px;
    }

    .success-whatsapp {
      display: inline-flex;
      margin-top: 18px;
      background: #25D366;
      color: white;
      border-radius: 999px;
      padding: 11px 17px;
      font-size: 13px;
      font-weight: 700;
    }

    /* TOAST */
    .toast {
      position: fixed;
      left: 50%;
      bottom: 150px;
      transform: translate(-50%, 20px);
      background: #17231e;
      color: white;
      padding: 11px 16px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      opacity: 0;
      pointer-events: none;
      z-index: 200;
      transition: .25s;
    }

    .toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    footer {
      text-align: center;
      padding: 25px 15px;
      color: var(--muted);
      font-size: 12px;
    }

    /* DESKTOP */
    @media (min-width: 650px) {
      header {
        padding: 40px 25px 50px;
      }

      main {
        padding-left: 25px;
        padding-right: 25px;
      }

      .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }

      .contact-row {
        grid-template-columns: repeat(3, 1fr);
      }

      .modal-overlay {
        align-items: center;
      }

      .modal {
        border-radius: 23px;
        max-height: 88vh;
      }
    }

    @media (min-width: 950px) {
      .product-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }
  </style>
</head>

